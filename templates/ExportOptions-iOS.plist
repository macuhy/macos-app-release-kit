<?xml version="1.0" encoding="UTF-8"?>
<!-- 放到【iOS App 私有仓库根目录】: ExportOptions-iOS.plist
     供 xcodebuild -exportArchive 使用，以 App Store 方式导出 .ipa（再由 altool 上传 TestFlight）。
     自动签名：配合 workflow 的 -allowProvisioningUpdates + API Key，Xcode 现签 profile，
     无需手动指定 provisioningProfiles（iCloud 等受限 entitlement 也自动管理）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Store / TestFlight 分发 -->
    <key>method</key>
    <string>app-store-connect</string>

    <!-- 你的 10 位 Team ID（替换） -->
    <key>teamID</key>
    <string>{{APPLE_TEAM_ID}}</string>

    <!-- 自动签名：profile 由 Xcode 用 API Key 现签 -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- 仅导出 .ipa；上传由 workflow 的 altool 步骤单独完成 -->
    <key>destination</key>
    <string>export</string>

    <!-- 上传崩溃符号；如不需要可设为 false -->
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
